{
  "name": "next-traks",
  "version": "1.0.2",
  "description": "Simple integration for Next.js and Traks privacy-friendly analytics",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./proxy": {
      "import": {
        "types": "./dist/proxy.d.ts",
        "default": "./dist/proxy.esm.js"
      },
      "require": {
        "types": "./dist/proxy.d.ts",
        "default": "./dist/proxy.js"
      }
    }
  },
  "author": "Shrinath Nayak <hi@snayak.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shrinathsnayak/next-traks.git"
  },
  "bugs": {
    "url": "https://github.com/shrinathsnayak/next-traks/issues"
  },
  "homepage": "https://github.com/shrinathsnayak/next-traks#readme",
  "funding": {
    "url": "https://github.com/sponsors/shrinathsnayak"
  },
  "keywords": [
    "next",
    "nextjs",
    "traks",
    "analytics",
    "privacy",
    "tracking",
    "cloudflare"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "build": "npm run clean && tsc --project ./tsconfig.json && rollup -c && rimraf --glob \"dist/lib/**/*.js\" \"dist/lib/**/*.js.map\"",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "next": "^13.0.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.30",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.6.1",
    "lint-staged": "^16.4.0",
    "next": "^16.0.0",
    "prettier": "^3.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^5.0.10",
    "rollup": "^2.80.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3"
  }
}
