{
  "compilerOptions": {
    "esModuleInterop": true,
    "outDir": "./dist",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "jsx": "react",
    "strict": true,
    "lib": ["es2022", "dom"],
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "lib/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
